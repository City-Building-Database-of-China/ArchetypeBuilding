    Zone Ideal Loads Zone Total Cooling Rate,    !- Variable Name
    Hourly;                   !- Reporting Frequency

OUTPUT:VARIABLE,
    *,                        !- Key Value
    Zone Air Temperature,     !- Variable Name
    Hourly;                   !- Reporting Frequency

OUTPUT:METER:METERFILEONLY,
    DistrictCooling:Facility,    !- Key Name
    Hourly;                   !- Reporting Frequency

OUTPUT:METER:METERFILEONLY,
    DistrictHeatingWater:Facility,    !- Key Name
    Hourly;                   !- Reporting Frequency

OUTPUT:METER:METERFILEONLY,
    Electricity:Facility,     !- Key Name
    Hourly;                   !- Reporting Frequency

OUTPUT:METER:METERFILEONLY,
    Electricity:Building,     !- Key Name
    Hourly;                   !- Reporting Frequency

OUTPUT:SQLITE,
    SimpleAndTabular,         !- Option Type
    UseOutputControlTableStyle;    !- Unit Conversion for Tabular Data